{% assign navigation = site.data.navigation[include.nav] %}
{% assign posts_count = site.posts | size %}

{% if navigation %}
  <nav class="nav__list">
    <input id="ac-toc" name="accordion-toc" type="checkbox" />
    <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Menu" }}</label>

    <ul class="nav__items" id="category_tag_menu">
      <li class="nav__summary">
        <i class="fas fa-folder-open" aria-hidden="true"></i>
        <span>전체 글 수 {{ posts_count }}개</span>
      </li>

      {% for section in navigation %}
        <li class="nav__section">
          {% if section.title %}
            <span class="nav__sub-title">{{ section.title }}</span>
          {% endif %}

          {% if section.children %}
            <ul>
              {% for child in section.children %}
                {% assign child_count = "" %}
                {% if child.category %}
                  {% assign category_posts = site.categories[child.category] %}
                  {% assign child_count = category_posts | size %}
                {% endif %}
                <li>
                  <a href="{{ child.url | relative_url }}">
                    <span>{{ child.title }}</span>
                    {% if child.category %}
                      <span class="nav__count">{{ child_count }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% elsif section.url %}
            <a href="{{ section.url | relative_url }}">{{ section.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
